{
  "_comment": "OpenClaw config 템플릿 — ~/.openclaw/openclaw.json에 복사해서 사용",
  "_setup": [
    "1. 본인 환경에 맞게 편집 (특히 API 키 부분)",
    "2. ~/.openclaw/openclaw.json 위치에 저장",
    "3. openclaw 명령으로 작동 확인"
  ],
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "openrouter/openai/gpt-oss-120b:free",
        "fallbacks": [
          "openrouter/qwen/qwen3-coder:free",
          "ollama/qwen2.5:7b"
        ]
      },
      "models": {
        "openrouter/openai/gpt-oss-120b:free": {},
        "openrouter/qwen/qwen3-coder:free": {},
        "ollama/qwen2.5:7b": {
          "alias": "qwen-local"
        }
      },
      "maxConcurrent": 4
    }
  },
  "models": {
    "providers": {
      "openrouter": {
        "_comment": "API 키는 환경변수 OPENROUTER_API_KEY로도 등록 가능"
      },
      "ollama": {
        "_comment": "Ollama 로컬 — 따로 모델 다운로드 필요 (ollama pull)",
        "baseUrl": "http://localhost:11434/v1",
        "apiKey": "ollama-local",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen2.5:7b",
            "name": "Qwen 2.5 7B",
            "input": ["text"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 32768,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "_apiKey_comment": "Brave Search API 키 (https://brave.com/search/api/, 2k/월 무료)",
        "apiKey": "YOUR_BRAVE_API_KEY"
      }
    }
  },
  "channels": {
    "telegram": {
      "_comment": "텔레그램 봇 (선택). BotFather에서 받은 토큰 입력.",
      "enabled": false,
      "botToken": "YOUR_BOT_TOKEN",
      "allowFrom": ["YOUR_TELEGRAM_USER_ID"],
      "dmPolicy": "allowlist"
    }
  }
}
